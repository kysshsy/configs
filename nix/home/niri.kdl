// Keyboard naming used below:
// - Mod is niri's logical Super key (the macOS-style Command layer).
// - Alt is the logical Alt key.
// - This config swaps the physical Alt and Win/Command keys via
//   `altwin:swap_alt_win` below. Therefore Mod/Alt refer to logical key
//   symbols, not necessarily the labels printed on the physical keyboard.
//
// The desktop starts from greetd. Mod+D opens the DMS launcher, and
// Mod+Shift+/ lists all Niri shortcuts.
input {
    keyboard {
        xkb {
            layout "us"
            options "altwin:swap_alt_win"
        }
    }
}

environment {
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"
}

spawn-at-startup "fcitx5" "-d"

layout {
    gaps 12
    default-column-width { proportion 0.6; }
}

include "niri-shortcuts.kdl"
