// The desktop starts from greetd. Super+T opens a terminal, Super+D opens
// the application launcher, and Super+Shift+/ lists all Niri shortcuts.
input {
    keyboard {
        xkb {
            layout "us"
        }
    }
}

layout {
    gaps 12
    default-column-width { proportion 0.6; }
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+T { spawn "wezterm"; }
    Mod+D { spawn "fuzzel"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit; }
}

spawn-at-startup "waybar"
