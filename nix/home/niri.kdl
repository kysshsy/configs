// The desktop starts from greetd. Super+T opens a terminal, Super+D opens
// the DMS launcher, and Super+Shift+/ lists all Niri shortcuts.
input {
    keyboard {
        xkb {
            layout "us"
        }
    }
}

environment {
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"
}

spawn-at-startup "fcitx5" "-d"

layout {
    gaps 12
    default-column-width { proportion 0.6; }
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+T { spawn "wezterm"; }
    Mod+Space { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+D { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+N { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+Comma { spawn "dms" "ipc" "call" "settings" "toggle"; }
    Mod+V { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+X { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    Super+Alt+L { spawn "dms" "ipc" "call" "lock" "lock"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit; }
}
