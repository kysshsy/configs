// The desktop starts from greetd. Mod+D opens the DMS launcher, and
// Mod+Shift+/ lists all Niri shortcuts.
input {
    keyboard {
        xkb {
            layout "us"
        }
    }
}

environment {
    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"
}

spawn-at-startup "fcitx5" "-d"

layout {
    gaps 12
    default-column-width { proportion 0.6; }
}

// Open WezTerm as a fullscreen window. The app-id covers both the native
// Wayland name and the common fallback reported by WezTerm.
window-rule {
    match app-id=r#"^(org\.wezfurlong\.wezterm|wezterm|wezterm-gui)$"#
    open-fullscreen true
}

include "niri-shortcuts.kdl"
